# Copy to `.env` in this folder — schema: apps/astro/src/env.ts
# Astro exposes only PUBLIC_* to the client. All have defaults if unset.

PUBLIC_ASTRO_URL=http://localhost:3002 # This site’s canonical URL
PUBLIC_CLIENT_URL=http://localhost:3001 # Filosign app URL (nav CTAs)
PUBLIC_SERVER_URL=http://localhost:3000 # Filosign API URL (if linked from marketing)
