# Copy to `apps/astro/.env` - schema: apps/astro/src/env.ts
# Astro exposes only PUBLIC_* to the client. Defaults apply if unset.
# Local: astro :3002 · client :3001 · API :3000

PUBLIC_ASTRO_URL=http://localhost:3002 # This site’s canonical URL (sitemap, OG, JSON-LD)
PUBLIC_CLIENT_URL=http://localhost:3001 # “Open app” CTA + help redirects to in-app support
PUBLIC_SERVER_URL=http://localhost:3000 # Filosign API URL (oRPC from islands)

# Pre-incorporation access fences (unset → off on production hostname, on for localhost):
# PUBLIC_DEPLOYMENT=local
# PUBLIC_CHECKOUT_ENABLED=false

# Deployed examples (Cloudflare Pages env):
# PUBLIC_ASTRO_URL=https://filosign.xyz
# PUBLIC_CLIENT_URL=https://app.filosign.xyz
# IndexNow runs on postbuild when PUBLIC_ASTRO_URL is not localhost (set INDEXNOW_SKIP=1 to disable)
