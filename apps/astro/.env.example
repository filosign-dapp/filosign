# Copy to `apps/astro/.env` — schema: apps/astro/src/env.ts
# Astro exposes only PUBLIC_* to the client. Defaults apply if unset.
# Local: astro :3002 · client :3001 · API :3000

PUBLIC_ASTRO_URL=http://localhost:3002 # This site’s canonical URL (sitemap, OG, JSON-LD)
PUBLIC_CLIENT_URL=http://localhost:3001 # Filosign app URL (nav CTAs — point to sandbox client until mainnet GA)
PUBLIC_SERVER_URL=http://localhost:3000 # Filosign API URL (health checks, islands)

# Deployed examples (Cloudflare Pages env):
# Sandbox marketing → PUBLIC_CLIENT_URL=https://sandbox.filosign.xyz
# Production marketing → PUBLIC_CLIENT_URL=https://app.filosign.xyz
