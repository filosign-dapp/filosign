---
import {
	marketingNarrowPageClass,
	marketingNarrowPageHeaderClass,
} from "../lib/marketing-layout";

interface Props {
	title: string;
	description: string;
	lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<article class={marketingNarrowPageClass}>
	<header class:list={[marketingNarrowPageHeaderClass, "space-y-3"]}>
		<h1 class="text-3xl md:text-4xl font-semibold tracking-tight font-manrope">
			{title}
		</h1>
		<p class="text-muted-foreground text-sm leading-relaxed">{description}</p>
		<p class="text-xs text-muted-foreground">Last updated: {lastUpdated}</p>
	</header>
	<div
		class="legal-prose space-y-6 text-sm leading-relaxed text-foreground/90 [&_h2]:text-lg [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:font-manrope [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2 [&_p]:text-foreground/85"
	>
		<slot />
	</div>
</article>
