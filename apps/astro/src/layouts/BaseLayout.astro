---
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/manrope/index.css";
import manropeLatinWoff2 from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import "../styles/global.css";
import {
	defaultDescription,
	defaultTitle,
	logo,
	parentOrganization,
	siteName,
	siteUrl,
	social,
	themeColor,
	twitterSite,
} from "../config/site";
import { ogSlugFromPathname } from "../lib/og-slug";

const OG_CANVAS_WIDTH = 1200;
const OG_CANVAS_HEIGHT = 630;

interface ArticleMeta {
	headline: string;
	datePublished: string;
	dateModified?: string;
	authorName: string;
}

interface Props {
	title?: string;
	description?: string;
	/** Relative URL for og:image - omit to use `/open-graph/{slug}.png` from astro-og-canvas */
	image?: string;
	canonicalUrl?: string;
	noIndex?: boolean;
	schemaVariant?: "product" | "article";
	article?: ArticleMeta;
	ogImageWidth?: number;
	ogImageHeight?: number;
	ogImageAlt?: string;
}

const FALLBACK_OG_WIDTH = 1920;
const FALLBACK_OG_HEIGHT = 1080;

const {
	title = defaultTitle,
	description = defaultDescription,
	image,
	canonicalUrl,
	noIndex = false,
	schemaVariant = "product",
	article,
	ogImageWidth,
	ogImageHeight,
	ogImageAlt,
} = Astro.props;

const logoUrl = new URL(logo.webp, `${siteUrl}/`).href;

const ogSlug = ogSlugFromPathname(Astro.url.pathname);
const resolvedOgImage = image ?? `/open-graph/${ogSlug}.png`;
const ogImageAbs = new URL(resolvedOgImage, `${siteUrl}/`).href;

const isCanvasOg = resolvedOgImage.startsWith("/open-graph/");

const path = Astro.url.pathname.replace(/\/$/, "") || "";
const defaultCanonical =
	path === "" || path === "/"
		? `${siteUrl}/`
		: `${siteUrl}${path.startsWith("/") ? path : `/${path}`}/`;
const canonical = canonicalUrl ?? defaultCanonical;

const ogW = ogImageWidth ?? (isCanvasOg ? OG_CANVAS_WIDTH : FALLBACK_OG_WIDTH);
const ogH =
	ogImageHeight ?? (isCanvasOg ? OG_CANVAS_HEIGHT : FALLBACK_OG_HEIGHT);
const ogAlt = ogImageAlt ?? title;

const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;

const graph: Record<string, unknown>[] = [
	{
		"@type": "WebSite",
		"@id": websiteId,
		url: siteUrl,
		name: siteName,
		description: defaultDescription,
		publisher: { "@id": orgId },
		inLanguage: "en",
	},
	{
		"@type": "Organization",
		"@id": orgId,
		name: siteName,
		url: siteUrl,
		logo: {
			"@type": "ImageObject",
			url: logoUrl,
			width: logo.width,
			height: logo.height,
		},
		sameAs: [social.x],
		parentOrganization: {
			"@type": "Organization",
			name: parentOrganization.name,
			url: parentOrganization.url,
		},
	},
];

if (schemaVariant === "article" && article) {
	graph.push({
		"@type": "BlogPosting",
		"@id": canonical,
		headline: article.headline,
		image: [ogImageAbs],
		url: canonical,
		datePublished: article.datePublished,
		dateModified: article.dateModified ?? article.datePublished,
		author: {
			"@type": "Person",
			name: article.authorName,
		},
		publisher: { "@id": orgId },
		mainEntityOfPage: {
			"@type": "WebPage",
			"@id": canonical,
		},
		description,
	});
} else {
	graph.push({
		"@type": "SoftwareApplication",
		"@id": `${siteUrl}/#software`,
		name: siteName,
		description,
		applicationCategory: "BusinessApplication",
		operatingSystem: "Web",
		url: siteUrl,
		publisher: { "@id": orgId },
	});
}

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": graph,
};

const isArticle = schemaVariant === "article" && article;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="canonical" href={canonical} />

		<link
			rel="preload"
			href={manropeLatinWoff2}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<link rel="icon" href={logo.webp} type="image/webp" sizes="512x512" />
		<link rel="apple-touch-icon" href={logo.webp} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content={themeColor} />

		<meta property="og:locale" content="en_US" />
		<meta property="og:type" content={isArticle ? "article" : "website"} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbs} />
		<meta property="og:image:width" content={String(ogW)} />
		<meta property="og:image:height" content={String(ogH)} />
		<meta property="og:image:alt" content={ogAlt} />
		<meta property="og:site_name" content={siteName} />
		{
			isArticle && article && (
				<>
					<meta
						property="article:published_time"
						content={article.datePublished}
					/>
					<meta
						property="article:modified_time"
						content={article.dateModified ?? article.datePublished}
					/>
				</>
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={twitterSite} />
		<meta name="twitter:creator" content={twitterSite} />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbs} />

		<script
			type="application/ld+json"
			is:inline
			set:html={JSON.stringify(jsonLd)}
		/>
	</head>
	<body class="min-h-dvh antialiased bg-background text-foreground">
		<slot />
	</body>
</html>
