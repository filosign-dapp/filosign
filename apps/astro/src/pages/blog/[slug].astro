---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPostIsland from "../../components/islands/BlogPostIsland";
import MarketingPageShell from "../../components/MarketingPageShell.astro";
import { blogTitleWithBrand } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPostShellClass } from "../../lib/marketing-layout";
import "../../styles/blog-content.css";

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const pageTitle = blogTitleWithBrand(post.data.title);
---

<BaseLayout
	title={pageTitle}
	description={post.data.description}
	schemaVariant="article"
	article={{
		headline: post.data.title,
		datePublished: post.data.publishedISO,
		authorName: post.data.author.name,
	}}
>
	<MarketingPageShell>
		<BlogPostIsland
				client:load
				title={post.data.title}
				readingTime={post.data.readingTime}
				dateDisplay={post.data.dateDisplay}
				heroImage={post.data.heroImage}
				heroVideo={post.data.heroVideo}
			/>
		<div class={`blog-mdx ${blogPostShellClass} pb-12 md:pb-20`}>
			<Content />
		</div>
	</MarketingPageShell>
</BaseLayout>
