---
import { getCollection } from "astro:content";
import BlogHeroIsland from "../../components/islands/BlogHeroIsland";
import BlogListIsland from "../../components/islands/BlogListIsland";
import MarketingPageShell from "../../components/MarketingPageShell.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sorted = [...posts].sort(
	(a, b) =>
		new Date(b.data.publishedISO).getTime() -
		new Date(a.data.publishedISO).getTime(),
);
const featured = sorted.find((p) => p.data.featured) ?? sorted[0];
---

<BaseLayout
	title="Blog - News and updates from Filosign"
	description="Engineering and product notes from Filosign: E2EE signing, placement manifests, wallet unlock, and decentralized agreement infrastructure."
>
	<MarketingPageShell>
		{
			featured && (
				<BlogHeroIsland
					client:load
					title={featured.data.title}
					description={featured.data.description}
					dateDisplay={featured.data.dateDisplay}
					readHref={`/blog/${featured.id}`}
				/>
			)
		}

		<BlogListIsland client:load posts={sorted} />
	</MarketingPageShell>
</BaseLayout>
