---
import { getCollection } from "astro:content";
import { env } from "../../../env";

/** Legacy toast URLs → in-app Support Center with hash anchor. */
export async function getStaticPaths() {
	const articles = await getCollection("helpErrors");
	return articles.map((article) => ({
		params: { slug: article.id },
	}));
}

const { slug } = Astro.params;
const clientBase = env.PUBLIC_CLIENT_URL.replace(/\/$/, "");
const target = `${clientBase}/dashboard/support#${slug}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ target }}>
			location.replace(target);
		</script>
	</head>
	<body>
		<p>
			<a href={target}>Continue to Support Center</a>
		</p>
	</body>
</html>
