---
import { env } from "../../env";

const clientBase = env.PUBLIC_CLIENT_URL.replace(/\/$/, "");
const target = `${clientBase}/dashboard/support`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ target }}>
			location.replace(target);
		</script>
	</head>
	<body>
		<p>
			<a href={target}>Continue to Support Center</a>
		</p>
	</body>
</html>
