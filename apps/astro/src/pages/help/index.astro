---
const target = "/docs/troubleshooting";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={new URL(target, Astro.site).href} />
		<title>Redirecting…</title>
		<script is:inline define:vars={{ target }}>
			location.replace(target);
		</script>
	</head>
	<body>
		<p>
			<a href={target}>Continue to Troubleshooting</a>
		</p>
	</body>
</html>
