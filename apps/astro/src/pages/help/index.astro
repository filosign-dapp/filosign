---
import { getCollection } from "astro:content";
import MarketingNarrowPage from "../../components/MarketingNarrowPage.astro";
import MarketingPageShell from "../../components/MarketingPageShell.astro";
import { titleWithBrand } from "../../config/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { renderHelpStepHtml } from "../../lib/help-step-html";
import {
	marketingNarrowPageHeaderClass,
	marketingNarrowPageStackClass,
} from "../../lib/marketing-layout";

/** Steps-only body for accordion panels (from `## What to do` in each MDX file). */
function parseHelpSteps(body: string): string[] {
	const match = body.match(/## What to do\r?\n([\s\S]*?)(?=\r?\n## |\s*$)/);
	if (!match) return [];
	return match[1]
		.split(/\r?\n/)
		.map((line) => line.trim())
		.filter((line) => /^\d+\.\s+/.test(line))
		.map((line) => line.replace(/^\d+\.\s+/, ""));
}

const raw = await getCollection("helpErrors");

function helpCategory(code: string): string {
	if (code.startsWith("SIGNING.")) return "Signing";
	if (code.startsWith("ENTITLEMENT.")) return "Billing & plans";
	if (code.startsWith("CLIENT.CRYPTO.")) return "Wallet & keys";
	if (code.startsWith("AUTH.")) return "Account";
	return "General";
}

const categoryOrder = [
	"Signing",
	"Billing & plans",
	"Wallet & keys",
	"Account",
	"General",
];

const rendered = raw.map((article) => ({
	article,
	steps: parseHelpSteps(article.body ?? ""),
	category: helpCategory(article.data.code),
}));

const grouped = categoryOrder
	.map((category) => ({
		category,
		items: rendered
			.filter((entry) => entry.category === category)
			.sort((a, b) => a.article.data.title.localeCompare(b.article.data.title)),
	}))
	.filter((group) => group.items.length > 0);

const pageTitle = titleWithBrand("Help");
const description =
	"Troubleshooting guides for messages you may see in Filosign—tap a topic to see what to do.";
---

<BaseLayout title={pageTitle} description={description}>
	<MarketingPageShell>
		<MarketingNarrowPage>
			<header class={marketingNarrowPageHeaderClass}>
				<h1
					class="text-3xl md:text-4xl font-semibold tracking-tight font-manrope text-balance text-foreground"
				>
					Common Issues & Solutions
				</h1>
				<p class="mt-4 max-w-lg text-base md:text-lg text-muted-foreground font-manrope text-pretty leading-relaxed">
					Match the issue on your screen, open it below, and follow the steps.
				</p>
			</header>

			<div class={marketingNarrowPageStackClass}>
				{
					grouped.map((group) => (
						<section aria-labelledby={`help-${group.category}`}>
							<h2
								id={`help-${group.category}`}
								class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground font-manrope"
							>
								{group.category}
							</h2>
							<div class="flex flex-col gap-2">
								{group.items.map(({ article, steps }) => (
									<details
										id={article.id}
										class="help-topic group rounded-2xl border border-border/60 bg-card/30 overflow-hidden transition-colors hover:border-border/90 open:bg-card/50"
									>
										<summary class="help-topic-summary flex min-h-11 cursor-pointer list-none items-start gap-3 px-4 py-3.5 text-left font-manrope focus-visible:outline-none focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background">
											<span class="min-w-0 flex-1">
												<span class="block text-base font-medium text-foreground text-pretty">
													{article.data.title}
												</span>
												<span class="mt-0.5 block text-sm text-muted-foreground line-clamp-2 text-pretty">
													{article.data.description}
												</span>
											</span>
											<svg
												class="help-topic-caret mt-0.5 size-5 shrink-0 text-muted-foreground"
												viewBox="0 0 256 256"
												fill="currentColor"
												aria-hidden="true"
											>
												<path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" />
											</svg>
										</summary>
										<div class="border-t border-border/40 bg-muted/15 px-4 py-4 md:px-5 md:py-5">
											{steps.length > 0 ? (
												<ol class="help-steps-list m-0 list-decimal space-y-3 pl-5 font-manrope text-sm leading-relaxed text-foreground/85 md:text-[0.9375rem]">
													{steps.map((step) => (
														<li
															class="text-pretty pl-1 marker:font-semibold marker:text-foreground"
															set:html={renderHelpStepHtml(step)}
														/>
													))}
												</ol>
											) : (
												<p class="text-sm leading-relaxed text-foreground/85 font-manrope">
													Open support for guidance on this message.
												</p>
											)}
										</div>
									</details>
								))}
							</div>
						</section>
					))
				}
			</div>

			<p class="mt-12 border-t border-border/50 pt-8 text-sm text-muted-foreground font-manrope text-pretty">
				Still stuck? Email{" "}
				<a
					href="mailto:support@filosign.xyz"
					class="font-medium text-foreground underline-offset-4 hover:underline"
				>
					support@filosign.xyz
				</a>
				.
			</p>
		</MarketingNarrowPage>
	</MarketingPageShell>
</BaseLayout>

<style>
	.help-topic-summary::-webkit-details-marker {
		display: none;
	}

	.help-topic-caret {
		transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.help-topic[open] .help-topic-caret {
		transform: rotate(180deg);
	}

	.help-steps-list :global(strong) {
		font-weight: 500;
		color: var(--foreground);
	}

	@media (prefers-reduced-motion: reduce) {
		.help-topic-caret {
			transition: none;
		}
	}
</style>

<script is:inline>
	function getHelpTopics() {
		return Array.from(document.querySelectorAll("details.help-topic"));
	}

	function closeOtherHelpTopics(except) {
		for (const item of getHelpTopics()) {
			if (item !== except && item.open) item.open = false;
		}
	}

	function bindHelpAccordion() {
		for (const details of getHelpTopics()) {
			details.addEventListener("toggle", () => {
				if (details.open) closeOtherHelpTopics(details);
			});
		}
	}

	function openHelpFromHash() {
		const id = decodeURIComponent(window.location.hash.slice(1));
		if (!id) return;
		const el = document.getElementById(id);
		if (el && el.tagName === "DETAILS") {
			closeOtherHelpTopics(el);
			el.open = true;
			el.scrollIntoView({ block: "start", behavior: "smooth" });
		}
	}

	bindHelpAccordion();
	openHelpFromHash();
	window.addEventListener("hashchange", openHelpFromHash);
</script>
