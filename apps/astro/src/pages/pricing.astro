---
import PricingHeroIsland from "../components/islands/PricingHeroIsland";
import PricingPlansIsland, {
	type PricingPlan,
} from "../components/islands/PricingPlansIsland";
import MarketingPageShell from "../components/MarketingPageShell.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const plans = [
	{
		name: "Solo",
		description:
			"For freelancers and solo operators who need private signing, proof exports, and client handoffs without team overhead. 7-day free trial.",
		price: { monthly: 20 },
		features: [
			"10 documents per month",
			"Up to 3 signers per document",
			"Private document workflows and proof packet export",
			"Gated file packets",
			"USDC payout packets (workspace approval required)",
			"Draft review links for clients",
		],
		cta: "Start Solo",
		highlight: false,
		planId: "individual",
	},
	{
		name: "Teams",
		description:
			"For small teams sharing templates, drafts, and pooled sending volume. Best for 2–10 people. 7-day free trial.",
		price: { monthly: 35 },
		features: [
			"15 documents per user per month (pooled)",
			"Up to 10 signers per document",
			"Shared templates and team envelope drafts",
			"Comments on documents and drafts",
			"Team envelope visibility on Home",
			"Per-packet recipient selection for gated files",
			"All Solo handoff features for team sends",
		],
		cta: "Start Teams",
		highlight: true,
		badge: "Best Value",
		planId: "teams",
	},
	{
		name: "Teams Pro",
		description:
			"For teams that need signing order, complex payouts, and conditional file release at higher volume. 7-day free trial.",
		price: { monthly: 59 },
		features: [
			"Everything in Teams, plus:",
			"25 documents per user per month",
			"Up to 15 signers per document",
			"Sequential signing order and quorum (minimum signatures)",
			"Multi-recipient payout rules",
			"Signature-conditional attachment release",
			// Catalog-only — not shipped; restore when implemented (see project/todo.md).
			// "Custom integrations",
			// "Seat quota allocation",
			// "Bulk send from CSV",
			// "Shared template folders",
			// "Custom branding on sign pages",
			// "Webhooks and metadata tags",
		],
		cta: "Start Teams Pro",
		highlight: false,
		planId: "teams_pro",
	},
] satisfies PricingPlan[];

const enterpriseBanner = {
	headline: "Are you an enterprise?",
	body: "Custom limits, security reviews, support terms, and procurement-friendly contracts for sensitive agreement workflows. Contact us directly and we'll scope a plan with your team.",
	cta: "Contact us",
	href: "mailto:sales@filosign.xyz?subject=Filosign%20Enterprise",
};
---

<BaseLayout
	title="Pricing - Private agreement workflows"
	description="Filosign pricing for private documents, proof exports, gated files, and payout packets. Enterprise plans by request."
>
	<MarketingPageShell>
		<PricingHeroIsland client:load />

		<PricingPlansIsland
			client:load
			plans={plans}
			enterpriseBanner={enterpriseBanner}
		/>
	</MarketingPageShell>
</BaseLayout>
