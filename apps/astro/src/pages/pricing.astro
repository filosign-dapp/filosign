---
import Footer from "../components/Footer.astro";
import PricingHeroIsland from "../components/islands/PricingHeroIsland";
import PricingPlansIsland from "../components/islands/PricingPlansIsland";
import Navbar from "../components/Navbar.astro";
import { env } from "../env";
import BaseLayout from "../layouts/BaseLayout.astro";

const appUrl = env.PUBLIC_CLIENT_URL;

const plans = [
	{
		name: "Free",
		description:
			"Test private signing workflows with encryption and proof exports—no card required.",
		price: { monthly: 0 },
		features: [
			"3 documents per month",
			"1 signer per envelope",
			"Encrypted in the browser before anything is uploaded",
			"Wallet-backed signing records",
			"Standard fields and a basic audit trail",
			"Manual reminder emails",
		],
		cta: "Start free",
		highlight: false,
	},
	{
		name: "Solo",
		description:
			"For freelancers, counsel, and operators who need private signing and clean proof records.",
		price: { monthly: 15 },
		features: [
			"Everything in Free, plus:",
			"10 documents per month",
			"Up to 3 signers per document",
			"Long-term verifiable storage options",
			"Full proof packet export",
			"Draft review links for clients",
			"Advanced fields and CSV export",
		],
		cta: "Start Solo",
		highlight: false,
		planId: "individual",
	},
	{
		name: "Teams",
		description:
			"For startups that need pooled quotas, shared workflows, and optional USDC settlement.",
		price: { monthly: 29 },
		features: [
			"15 documents per user per month (pooled)",
			"Up to 10 signers per document",
			"Shared templates and team envelope drafts",
			"Advanced routing and draft review links",
			"Team envelope visibility",
			"Optional USDC settlement when signing rules are met",
		],
		cta: "Start Teams",
		highlight: true,
		badge: "Best Value",
		planId: "teams",
	},
	{
		name: "Teams Pro",
		description:
			"For growing teams that need higher volume and operational control.",
		price: { monthly: 49 },
		features: [
			"Everything in Teams, plus:",
			"25 documents per user per month (pooled)",
			"Up to 15 signers per document",
			"Custom integrations",
			"Seat quota allocation",
			"Bulk send from CSV",
			"Shared template folders",
			"Custom branding on sign pages",
			"Webhooks and metadata tags",
		],
		cta: "Start Teams Pro",
		highlight: false,
		planId: "teams_pro",
	},
];

const enterpriseBanner = {
	headline: "Are you an enterprise?",
	body: "Custom limits, security reviews, support terms, and procurement-friendly contracts—contact us directly and we'll scope a plan with your team.",
	cta: "Contact us",
	href: "mailto:sales@filosign.xyz?subject=Filosign%20Enterprise",
};
---

<BaseLayout
	title="Pricing — Encrypted signing with proof you can verify"
	description="Filosign pricing: Free, Solo, Teams, and Teams Pro. Encrypted signing, proof exports, and optional USDC settlements. Enterprise plans by request."
>
	<a
		href="#main-content"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:ring-3 focus:ring-ring/50"
	>
		Skip to main content
	</a>
	<div class="[--section-gap:4rem] min-h-screen bg-background font-manrope selection:bg-primary/10 selection:text-primary">
		<Navbar />
		<div class="h-(--section-gap)"></div>
		<main id="main-content">
			<PricingHeroIsland client:load appUrl={appUrl} />

			<PricingPlansIsland
				client:load
				plans={plans}
				appUrl={appUrl}
				enterpriseBanner={enterpriseBanner}
			/>
		</main>
		<div class="h-(--section-gap)"></div>
		<Footer />
	</div>
</BaseLayout>
