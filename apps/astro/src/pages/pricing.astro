---
import Footer from "../components/Footer.astro";
import PricingHeroIsland from "../components/islands/PricingHeroIsland";
import PricingPlansIsland from "../components/islands/PricingPlansIsland";
import Navbar from "../components/Navbar.astro";
import { env } from "../env";
import BaseLayout from "../layouts/BaseLayout.astro";

const appUrl = env.PUBLIC_CLIENT_URL;

const plans = [
	{
		name: "Free",
		description:
			"Test private signing workflows with encryption and proof exports—no card required.",
		price: { monthly: 0 },
		features: [
			"3 documents per month",
			"1 signer per envelope",
			"Encrypted in the browser before anything is uploaded",
			"Wallet-backed signing records",
			"Standard fields and a basic audit trail",
			"Manual reminder emails",
		],
		cta: "Start free",
		highlight: false,
	},
	{
		name: "Solo",
		description:
			"For freelancers, counsel, and operators who need private signing and clean proof records.",
		price: { monthly: 15 },
		features: [
			"10 documents per month",
			"Up to 3 signers per document",
			"Long-term verifiable storage options",
			"Signer ID attachments stay encrypted end-to-end",
			"Advanced fields and CSV export for your records",
			"Same wallet-native security as every Filosign plan",
		],
		cta: "Start Solo",
		highlight: false,
		planId: "individual",
	},
	{
		name: "Teams",
		description:
			"For teams that need shared workflows, proof packets, and optional USDC settlement.",
		price: { monthly: 39 },
		features: [
			"30 documents per teammate each month",
			"Up to 10 signers per document",
			"Optional USDC settlement when signing rules are met",
			"Shared templates and team envelope drafts",
			"Signing order, review links, and draft comments",
			"Team visibility on envelopes and automated reminders",
		],
		cta: "Start Teams",
		highlight: true,
		badge: "Most popular",
		planId: "teams",
	},
	{
		name: "Teams Pro",
		description:
			"For high-volume teams that need more seats, workflows, and integration support.",
		price: { monthly: 59 },
		features: [
			"60 documents/month per seat",
			"Up to 20 signers per document",
			"Everything in Teams",
			"Custom integrations with your stack",
			"Advanced proof exports and signature audit records",
			"Priority support for production workloads",
		],
		cta: "Start Teams Pro",
		highlight: false,
		planId: "teams_pro",
	},
];

const enterpriseBanner = {
	headline: "Are you an enterprise?",
	body: "Custom limits, security reviews, support terms, and procurement-friendly contracts—contact us directly and we'll scope a plan with your team.",
	cta: "Contact us",
	href: "mailto:hello@filosign.xyz?subject=Filosign%20Enterprise",
};
---

<BaseLayout
	title="Pricing — Encrypted signing with proof you can verify"
	description="Filosign pricing: Free, Solo, Teams, and Teams Pro. Encrypted signing, proof exports, and optional USDC settlements. Enterprise plans by request."
>
	<div class="min-h-screen bg-background font-manrope selection:bg-primary/10 selection:text-primary">
		<Navbar />
		<main>
			<PricingHeroIsland client:load appUrl={appUrl} />

			{/* Pricing Section with Dynamic Billing Toggle */}
			<PricingPlansIsland
				client:load
				plans={plans}
				appUrl={appUrl}
				enterpriseBanner={enterpriseBanner}
			/>
		</main>
		<Footer />
	</div>
</BaseLayout>
														
