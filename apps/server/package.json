{
	"name": "@filosign/server",
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./api/orpc/router": "./api/orpc/router.ts",
		"./api/orpc/context": "./api/orpc/context.ts"
	},
	"scripts": {
		"dev:local": "bun run --env-file=.env.local --hot index.ts",
		"dev:staging": "infisical run --env=staging --path=/app -- bun run --hot index.ts",
		"dev:sandbox": "infisical run --env=sandbox --path=/app -- bun run --hot index.ts",
		"db:purge:local": "bun run --env-file=.env.local scripts/clear-db.ts",
		"db:purge:staging": "infisical run --env=staging --path=/app -- bun run scripts/clear-db.ts",
		"db:purge:sandbox": "infisical run --env=sandbox --path=/app -- bun run scripts/clear-db.ts",
		"drizzle-kit:push": "bunx --bun drizzle-kit push",
		"drizzle-kit:migrate": "bunx --bun drizzle-kit migrate",
		"drizzle-kit:generate": "bunx --bun drizzle-kit generate",
		"db:generate": "bun run scripts/db/generate.ts",
		"drizzle-kit:check": "bunx --bun drizzle-kit check",
		"db:push:local": "bun run --env-file=.env.local drizzle-kit:push",
		"db:push:staging": "infisical run --env=staging --path=/app -- bun run drizzle-kit:push",
		"db:migrate:local": "bun run --env-file=.env.local drizzle-kit:migrate",
		"db:migrate:staging": "infisical run --env=staging --path=/app -- bun run drizzle-kit:migrate",
		"db:migrate:sandbox": "infisical run --env=sandbox --path=/app -- bun run drizzle-kit:migrate",
		"db:migrate:production": "infisical run --env=prod --path=/app -- bun run drizzle-kit:migrate",
		"db:migration:check": "bun run scripts/db/check.ts",
		"db:confirm-migration-commit": "bun run scripts/db/confirm-migration-commit.ts",
		"db:verify-migrations": "bun run scripts/db/verify.ts",
		"db:grant-plan:local": "bun run --env-file=.env.local scripts/grant-admin-plan.ts",
		"db:grant-plan:staging": "infisical run --env=staging --path=/app -- bun run scripts/grant-admin-plan.ts",
		"db:grant-plan:sandbox": "infisical run --env=sandbox --path=/app -- bun run scripts/grant-admin-plan.ts",
		"compile": "mkdir -p assets && cp -f ../../packages/crypto-utils/assets/dilithium.wasm assets/ && bun build --compile --minify --sourcemap --bytecode ./index.ts --outfile out/server && bun build --compile --minify --sourcemap --bytecode ./worker.ts --outfile out/worker && bun build --compile --minify --bytecode ./worker-healthcheck.ts --outfile out/worker-healthcheck && bun build --compile --minify --bytecode ./scripts/db/runtime.ts --outfile out/drizzle-migrate",
		"dev:worker:local": "bun run --env-file=.env.local worker.ts",
		"check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
		"test": "bun test tests/"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.888.0",
		"@filosign/evm": "workspace:*",
		"@filosign/crypto-utils": "workspace:*",
		"@filosign/emails": "workspace:*",
		"@filosign/entitlements": "workspace:*",
		"@filosign/errors": "workspace:*",
		"@filosign/logger": "workspace:*",
		"@filosign/shared": "workspace:*",
		"@filoz/synapse-sdk": "^0.41.0",
		"@orpc/experimental-pino": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"bullmq": "^5.49.1",
		"dodopayments": "^2.1.0",
		"drizzle-orm": "0.45.2",
		"fast-json-stable-stringify": "catalog:",
		"hono": "catalog:",
		"ioredis": "5.10.1",
		"pg": "8.16.3",
		"resend": "6.4.0",
		"thirdweb": "catalog:",
		"viem": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"ethers": "catalog:",
		"@t3-oss/env-core": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "8.15.6",
		"drizzle-kit": "0.31.6"
	}
}
