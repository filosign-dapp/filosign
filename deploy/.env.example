# Copy to deploy/.env (gitignored) for compose stacks.
# Image pins (optional — defaults are set in compose files)

POSTGRES_IMAGE=postgres:18-alpine
PGBACKREST_IMAGE=percona/percona-pgbackrest:2.58.0-1
DRAGONFLY_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly:v1.37.2

# pgBackRest → R2
# PGBACKREST_RETENTION_DAYS=30 maps to repo1-retention-full-time=30d in pgbackrest.conf
PGBACKREST_RETENTION_DAYS=30
PGBACKREST_REPO_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
PGBACKREST_REPO_S3_BUCKET=filosign-pg-backups-dev
PGBACKREST_REPO_S3_KEY=
PGBACKREST_REPO_S3_KEY_SECRET=
PGBACKREST_CIPHER_PASS=
