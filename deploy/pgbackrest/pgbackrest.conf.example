# Copy to pgbackrest.conf (gitignored) and fill from deploy/.env
# R2: repo1-s3-uri-style=path is required

[global]
repo1-type=s3
repo1-s3-endpoint=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
repo1-s3-bucket=filosign-pg-backups-dev
repo1-s3-key=YOUR_R2_ACCESS_KEY_ID
repo1-s3-key-secret=YOUR_R2_SECRET_ACCESS_KEY
repo1-s3-region=auto
repo1-s3-uri-style=path
repo1-retention-full-type=time
repo1-retention-full-time=30d
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=change-me-long-random-passphrase
lock-path=/var/lib/pgbackrest/lock
log-path=/var/lib/pgbackrest/log

[filosign]
# PG 18 official image: PGDATA is /var/lib/postgresql/18/docker (volume mount at /var/lib/postgresql)
pg1-path=/var/lib/postgresql/18/docker
pg1-user=filosign
pg1-database=filosign
# Do not set pg1-host when postgres_data is mounted in this container (VPS sidecar or dev-full).
# pg1-host=postgres implies SSH and fails in Docker unless you configure pg1-host-type=tls + certs.
