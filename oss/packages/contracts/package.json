{
	"name": "@filosign/contracts",
	"version": "1.0.0",
	"description": "Filosign on-chain contracts, public ABIs, and chain manifests for verify",
	"files": [
		"abis/**/*",
		"chains/**/*",
		"src/**/*"
	],
	"exports": {
		"./abis": {
			"types": "./abis/index.ts",
			"default": "./abis/index.ts"
		},
		"./chains": {
			"types": "./chains/index.ts",
			"default": "./chains/index.ts"
		}
	},
	"scripts": {
		"node": "bunx --bun hardhat node",
		"compile": "bun gen:interfaces; bunx --bun hardhat compile",
		"test": "bun compile; bun --bun hardhat test",
		"gen:interfaces": "bun run scripts/interfaces.ts",
		"check-types": "bunx --bun tsc --noEmit -p tsconfig.check.json"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-network-helpers": "^1.1.0",
		"@nomicfoundation/hardhat-toolbox-viem": "^4.1.0",
		"@nomicfoundation/hardhat-viem": "^2.1.1",
		"@openzeppelin/contracts": "^5.4.0",
		"@solidity-parser/parser": "^0.18.0",
		"@types/bun": "catalog:",
		"@types/chai": "^4.3.20",
		"@types/chai-as-promised": "^7.1.8",
		"@types/mocha": "^10.0.10",
		"@types/node": "catalog:",
		"chai": "^4.5.0",
		"glob": "^11.0.3",
		"hardhat": "^2.26.3",
		"mocha": "11.7.4",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"viem": "catalog:"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
