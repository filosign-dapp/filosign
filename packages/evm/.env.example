# Copy to `packages/evm/.env.local` | `.env.staging` | `.env.production` - schema: packages/evm/env.ts
# Chain deploy profiles (not server DEPLOYMENT): local Hardhat, testnet Base Sepolia, mainnet Base.
# Testnet contracts are shared by server staging + sandbox (same chain, different off-chain data).

# Hardhat unit tests use the in-process network; FC_DEPLOYER_PRIVATE_KEY is not required for `bun run contracts -- test`.

# Required for deploy / live networks
# FC_DEPLOYER_PRIVATE_KEY=0x... # Deployer wallet private key (0x + 64 hex)
# RELAYER_POOL=0x...,0x... # Comma-separated relayer addresses → FSEnvelopeRegistry initialRelayers (must match apps/server RELAYER_POOL)
# FC_OWNER_ADDRESS=0x... # Cold owner / ownership handoff target

# Local Hardhat defaults (accounts #1 and #2):
# RELAYER_POOL=0x70997970C51812dc3A010C7d01b50e0d17dc79C8,0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Optional
# ALCHEMY_API_KEY= # Alchemy RPC for fork/deploy scripts
# ETHERSCAN_API_KEY= # Etherscan API for contract verification
