{
	"name": "@filosign/evm",
	"version": "1.0.0",
	"private": true,
	"exports": {
		".": {
			"default": "./index.ts"
		},
		"./definitions/chain-key": {
			"default": "./definitions/chain-key.ts"
		},
		"./definitions/schema": {
			"default": "./definitions/schema.ts"
		},
		"./definitions/index": {
			"default": "./definitions/index.ts"
		},
		"./definitions/mock-usdc": {
			"default": "./definitions/mock-usdc.ts"
		}
	},
	"scripts": {
		"gen:definitions": "bun run scripts/gen-definitions.ts",
